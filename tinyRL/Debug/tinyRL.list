    // healthy_reward = 1.0 solo se il Hopper è sano (obs[0]=z >= 0.7, obs[1]=angle in [-0.2, 0.2])
    // obs[5] = qvel[0] = forward (x) velocity
    float healthy = (obs[0] >= 0.7f && obs[1] >= -0.2f && obs[1] <= 0.2f) ? 1.0f : 0.0f;
